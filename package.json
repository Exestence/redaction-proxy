{
  "name": "redaction-proxy",
  "version": "0.3.0",
  "private": true,
  "description": "Local proxy that masks PII and secrets in LLM API requests and restores them in responses, plus the redaction core it is built on",
  "keywords": [
    "llm",
    "proxy",
    "redaction",
    "pii",
    "privacy",
    "secrets",
    "openai",
    "anthropic"
  ],
  "homepage": "https://github.com/Exestence/redaction-proxy#readme",
  "bugs": {
    "url": "https://github.com/Exestence/redaction-proxy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exestence/redaction-proxy.git"
  },
  "type": "module",
  "main": "lib/core/index.js",
  "types": "lib/core/index.d.ts",
  "bin": {
    "redaction-proxy": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./proxy": {
      "types": "./lib/proxy/server.d.ts",
      "default": "./lib/proxy/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "NOTICE",
    "config.example.toml"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "tsc -p tsconfig.build.json && node bench/false-positives.mjs",
    "start": "node lib/cli.js",
    "demo": "tsc -p tsconfig.build.json && node lib/cli.js --demo",
    "bench:public": "node --experimental-transform-types --disable-warning=ExperimentalWarning bench/public/main.ts",
    "e2e:real": "node --experimental-transform-types --disable-warning=ExperimentalWarning e2e/real/main.ts",
    "bench:presidio:setup": "uv venv bench/presidio/.venv --python 3.12 --allow-existing && uv pip install --python bench/presidio/.venv/bin/python -r bench/presidio/requirements.txt"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "onnxruntime-node": "1.30.0",
    "tokenizers": "0.23.2"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    },
    "tokenizers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "smol-toml": "1.9.1"
  }
}
